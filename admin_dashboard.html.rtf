div>\line                     <label class="block text-xs font-semibold text-slate-600 mb-1">WhatsApp Number</label>\line                     <input type="text" name="whatsapp_number" placeholder="018xxxxxxxx" class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-teal-500">\line                 </div>\line\line                 <!-- Logistics & Socials -->\line                 <div class="pt-2 border-t border-slate-100 space-y-3">\line                     <p class="text-xs font-bold text-teal-700 uppercase tracking-wider">Logistics & Profile</p>\line                     <div>\line                         <label class="block text-xs font-semibold text-slate-600 mb-1">T-Shirt Size</label>\line                         <select name="tshirt_size" class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-teal-500 bg-white">\line                             <option value="">-- Select Size --</option>\line                             <option value="S">S</option>\line                             <option value="M">M</option>\line                             <option value="L">L</option>\line                             <option value="XL">XL</option>\line                             <option value="XXL">XXL</option>\line                         </select>\line                     </div>\line                     <div>\line                         <label class="block text-xs font-semibold text-slate-600 mb-1">Date of Birth</label>\line                         <input type="date" name="date_of_birth" class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-teal-500">\line                     </div>\line                     <div>\line                         <label class="block text-xs font-semibold text-slate-600 mb-1">Facebook URL</label>\line                         <input type="url" name="facebook_url" placeholder="https://facebook.com/..." class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-teal-500">\line                     </div>\line                     <div>\line                         <label class="block text-xs font-semibold text-slate-600 mb-1">LinkedIn URL</label>\line                         <input type="url" name="linkedin_url" placeholder="https://linkedin.com/in/..." class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-teal-500">\line                     </div>\line                     <div>\line                         <label class="block text-xs font-semibold text-slate-600 mb-1">Expertise / Hobbies</label>\line                         <input type="text" name="expertise_hobbies" placeholder="e.g. AI, Coding" class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-teal-500">\line                     </div>\line                 </div>\line\line                 <button type="submit" class="w-full py-2.5 bg-teal-600 hover:bg-teal-700 text-white font-semibold rounded-xl text-sm transition shadow-md shadow-teal-200">\line                     Add Teacher\line                 </button>\line             </form>\line         </div>\line\line         <!-- 3. Create Batch Form -->\line         <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 space-y-4">\line             <div class="flex items-center space-x-2 border-b border-slate-100 pb-3">\line                 <span class="text-xl">\f1\u-10179?\u-8986?\f0 </span>\line                 <h2 class="text-lg font-bold text-slate-800">Create New Batch</h2>\line             </div>\line             <form action="/admin/batches" method="POST" class="space-y-3">\line                 <div>\line                     <label class="block text-xs font-semibold text-slate-600 mb-1">Batch Name *</label>\line                     <input type="text" name="batch_name" required placeholder="e.g. Emerald Batch A" class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-blue-500">\line                 </div>\line                 <div>\line                     <label class="block text-xs font-semibold text-slate-600 mb-1">Max Capacity</label>\line                     <input type="number" name="max_capacity" value="30" class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-blue-500">\line                 </div>\line                 <div>\line                     <label class="block text-xs font-semibold text-slate-600 mb-1">Schedule</label>\line                     <input type="text" name="class_schedule" placeholder="e.g. Mon/Wed/Fri 5:00 PM" class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-blue-500">\line                 </div>\line                 <div>\line                     <label class="block text-xs font-semibold text-slate-600 mb-1">Assigned Teacher</label>\line                     <select name="assigned_teacher_id" class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-blue-500 bg-white">\line                         <option value="">-- Unassigned --</option>\line                         \{% for t in teachers %\}\line                         <option value="\{\{ t.id \}\}">\{\{ t.name \}\}</option>\line                         \{% endfor %\}\line                     </select>\line                 </div>\line                 <button type="submit" class="w-full py-2.5 bg-slate-800 hover:bg-slate-900 text-white font-semibold rounded-xl text-sm transition shadow-md">\line                     Create Batch\line                 </button>\line             </form>\line         </div>\line\line     </div>\line\line </div>\line\{% endblock %\}\par

